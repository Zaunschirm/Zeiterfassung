{
  "version": 2,
  "routes": [
    {
      "src": "/wichtel",
      "dest": "/wichtel/index.html"
    },
    {
      "src": "/wichtel/",
      "dest": "/wichtel/index.html"
    },
    {
      "src": "/wichtel/manifest.webmanifest",
      "dest": "/wichtel/manifest.webmanifest"
    },
    {
      "src": "/wichtel/sw.js",
      "dest": "/wichtel/sw.js"
    },
    {
      "src": "/wichtel/icon.svg",
      "dest": "/wichtel/icon.svg"
    },
    {
      "src": "/sw.js",
      "dest": "/sw.js"
    },
    {
      "src": "/manifest.webmanifest",
      "dest": "/manifest.webmanifest"
    },
    {
      "src": "/icon-192.png",
      "dest": "/icon-192.png"
    },
    {
      "src": "/icon-512.png",
      "dest": "/icon-512.png"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
